# Copy to .env for development or an operator-owned .env.production on the VPS.
NODE_ENV=development
# Production defaults to closed registration until staging is verified.
PUBLIC_REGISTRATION=false
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://erect_app:CHANGE_ME@127.0.0.1:5432/erect3d
DATABASE_TLS=disable
# Production: verify-full; use a trusted certificate/CA and its matching hostname.
DATABASE_CA_FILE=
DATABASE_SERVER_NAME=
DB_POOL_SIZE=10
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_NAME=erect_session
SESSION_IDLE_SECONDS=86400
SESSION_ABSOLUTE_SECONDS=2592000
# PostgreSQL protection is supported; Redis protection fails closed if Redis is down.
RATE_LIMIT_BACKEND=postgres
REDIS_URL=
# Every bucket and object must be private. No credentials belong in VITE_* variables.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=209715200
MAX_PROJECT_BYTES=33554432
# Optional cloud interpretation. Missing AI does not prevent architectural editing.
GEMINI_API_KEY=AIzaSyArdTDN-HSu_WbG6JKtd7HcL4JnxSEOGTM
GEMINI_MODEL_PLAN=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_COMPLEX=gemini-3.8-flash
AI_DAILY_LIMIT=25
AI_TIMEOUT_MS=90000
SNAPSHOT_INTERVAL=50
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=120
LOG_LEVEL=info
TRUSTED_PROXY_IPS=
# Explicit test databases must end in _test. Never run tests on production data.
TEST_DATABASE_URL=postgres://erect_test:CHANGE_ME@127.0.0.1:5432/erect_api_test
TEST_REDIS_URL=
