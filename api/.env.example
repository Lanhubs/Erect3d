# Required for local API/worker development. Never use these credentials in production.
NODE_ENV=development
DATABASE_URL=postgres://erect_dev:local-development-only@127.0.0.1:55432/erect_dev
HOST=127.0.0.1
PORT=4000
PUBLIC_REGISTRATION=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tests: disposable database only, ending in _test. Migrate using bun run test:prepare.
TEST_DATABASE_URL=postgres://erect_dev:local-development-only@127.0.0.1:55432/erect_api_test
# Optional Redis test; leave empty unless running the redis Compose profile.
TEST_REDIS_URL=

# Optional private R2 storage: supply all four together, or leave all empty.
STORAGE_BACKEND=r2
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Optional private filesystem alternative; requires a random signing key >=32 characters.
STORAGE_ROOT=
STORAGE_SIGNING_KEY=
PDF_OPTIMIZER_PATH=
ASSET_OPTIMIZE_TIMEOUT_MS=30000
MAX_UPLOAD_BYTES=209715200
MAX_PROJECT_BYTES=33554432

# Optional Gemini. Never use real keys for the automated test suite.
GEMINI_API_KEY=
GEMINI_MODEL_PLAN=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_COMPLEX=gemini-3.8-flash
# Optional bounded source repair; blank reuses the interpretation model.
GEMINI_MODEL_REPAIR=gemini-4-argon
# Assistant editing only; reconstruction keeps its separate models above.
# Argon requires paid Gemini API access. Set a different supported tool-calling model if needed.
GEMINI_MODEL_AGENT=gemini-4-argon
AI_DAILY_LIMIT=25
AI_TIMEOUT_MS=90000

# Database, sessions, proxy and worker tuning. Production requires verified DB TLS.
DATABASE_TLS=disable
DATABASE_CA_FILE=
DATABASE_SERVER_NAME=
DB_POOL_SIZE=10
COOKIE_NAME=erect_session
SESSION_IDLE_SECONDS=86400
SESSION_ABSOLUTE_SECONDS=2592000
TRUSTED_PROXY_IPS=
RATE_LIMIT_BACKEND=postgres
REDIS_URL=
SNAPSHOT_INTERVAL=50
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=120

# Self-hosted observability, off unless an OTLP HTTP logs endpoint is configured.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_SERVICE_NAME=erect3d-api

# Optional operator scripts, not required for installation or automated tests.
SEED_EMAIL=
SEED_PASSWORD=
SMOKE_PORT=44001
LIVE_AI_PASS=structure
LIVE_STORAGE_ORIGIN=
LIVE_GEMINI_CONFIRM=
