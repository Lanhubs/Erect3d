{
  "name": "@erect3d/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "worker": "bun src/workers/index.ts",
    "migrate": "bun scripts/migrate.ts",
    "seed": "bun scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check:lines": "bun scripts/check-lines.ts",
    "check:startup": "bun scripts/check-startup.ts",
    "check:storage": "bun scripts/check-storage.ts",
    "check:ai": "bun scripts/check-ai.ts",
    "verify": "bun run check:lines && bun run typecheck && bun test tests"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@hono/bun": "^1.0.0",
    "hono": "^4.0.0",
    "sharp": "^0.34.0",
    "three": "^0.186.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/three": "^0.186.0",
    "typescript": "~6.0.2"
  }
}
