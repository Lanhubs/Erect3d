{
  "name": "@erect3d/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "lint": "oxlint --config ../.oxlintrc.json src client scripts tests",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "worker": "bun src/workers/index.ts",
    "migrate": "bun scripts/migrate.ts",
    "seed": "bun scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests --timeout=20000",
    "check:lines": "bun scripts/check-lines.ts",
    "check:startup": "bun scripts/check-startup.ts",
    "check:storage": "bun scripts/check-storage.ts",
    "check:ai": "bun scripts/check-ai.ts",
    "verify": "bun run check:lines && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@hono/bun": "^1.0.0",
    "@sentry/bun": "11.10.0",
    "@sentry/hono": "11.10.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@tesseract.js-data/eng": "1.0.0",
    "dxf-parser": "1.1.2",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0",
    "three": "0.186.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/three": "0.186.0",
    "typescript": "~6.0.2"
  }
}
