# Projects and samples use the API; IndexedDB caches opened projects for offline work.
# Development shows signup automatically. For a production build or local preview,
# set this to true only when the API also enables PUBLIC_REGISTRATION.
VITE_PUBLIC_REGISTRATION=false
# Empty = same origin (/api behind Nginx). Never put server secrets in VITE_*.
VITE_API_ORIGIN=
# Development-only proxy targets, read by the Bun-launched Vite configuration.
ERECT_API_PROXY=http://127.0.0.1:4000
ERECT_FILM_PROXY=http://127.0.0.1:5191
